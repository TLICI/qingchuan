<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="24dp"
        android:paddingRight="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scene_title"
            android:textColor="#111827"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/scene_hint"
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/scene_elements"
            android:textColor="#111827"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/sceneSun"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/scene_sun"
            android:textColor="#1F2937"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/sceneClouds"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/scene_clouds"
            android:textColor="#1F2937"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/sceneBirds"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/scene_birds"
            android:textColor="#1F2937"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/sceneWater"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/scene_water"
            android:textColor="#1F2937"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/scenePines"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/scene_pines"
            android:textColor="#1F2937"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/cloudCountLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/scene_cloud_count"
            android:textColor="#374151"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/cloudSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/birdCountLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/scene_bird_count"
            android:textColor="#374151"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/birdSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/pineCountLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/scene_pine_count"
            android:textColor="#374151"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/pineSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/sceneReset"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="#FFFFFF"
            android:text="@string/scene_reset"
            android:textColor="#1F2937"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
